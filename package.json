{
  "name": "editable-blog",
  "version": "0.44.21",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-check --fail-on-warnings && vite build",
    "preview": "bun server.js",
    "test": "bun test",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "release": "release-it",
    "postbuild": "bun scripts/generate-seo-files.js && bun scripts/run-pagefind.js && bun scripts/generate-rss-feed.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.69.2",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/bun": "1.4.2",
    "autoprefixer": "10.5.2",
    "daisyui": "5.6.18",
    "husky": "9.1.7",
    "pagefind": "1.5.2",
    "postcss": "8.5.19",
    "svelte": "5.56.4",
    "svelte-check": "4.7.6",
    "svelte-sitemap": "4.1.2",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  },
  "type": "module",
  "dependencies": {
    "@release-it/conventional-changelog": "11.0.1",
    "@tailwindcss/postcss": "4.3.2",
    "@tailwindcss/typography": "0.5.20",
    "gray-matter": "4.0.3",
    "mdsvex": "0.12.7",
    "mermaid": "11.16.0",
    "rehype-slug": "6.0.0",
    "release-it": "20.2.1",
    "remark-gfm": "4.0.1",
    "svg-pan-zoom": "3.6.2",
    "tailwindcss": "4.3.2"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it@19/schema/release-it.json",
    "git": {
      "commitMessage": "chore: release v${version}",
      "pushArgs": [
        "--follow-tags",
        "--atomic"
      ]
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "infile": "CHANGELOG.md"
      }
    }
  },
  "packageManager": "bun@1.4.2"
}
