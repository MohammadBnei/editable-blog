{
  "name": "editable-blog",
  "version": "0.42.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "bun server.js",
    "test": "bun test",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "release": "release-it",
    "prepare": "husky install",
    "postbuild": "node scripts/generate-seo-files.js && node scripts/run-pagefind.js && node scripts/generate-rss-feed.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/vite-plugin-svelte": "^6",
    "autoprefixer": "^10.5.2",
    "daisyui": "^5.6.18",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.4",
    "vite": "^7"
  },
  "type": "module",
  "dependencies": {
    "@release-it/conventional-changelog": "^11.0.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "gray-matter": "^4.0.3",
    "mdsvex": "^0.12.6",
    "mermaid": "^11.16.0",
    "rehype-slug": "^6.0.0",
    "release-it": "^20.2.1",
    "remark-gfm": "^4.0.1",
    "svg-pan-zoom": "^3.6.2",
    "tailwindcss": "^4.3.2"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it@19/schema/release-it.json",
    "git": {
      "commitMessage": "chore: release v${version}"
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "infile": "CHANGELOG.md"
      }
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run format"
    }
  }
}
